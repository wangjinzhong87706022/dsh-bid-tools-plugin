# ===== 复制为 .env 后按实际部署修改 =====

# MCP 服务
MCP_HOST=0.0.0.0
MCP_PORT=8300
MCP_TRANSPORT=streamable-http

# LLM 节点（Qwen3.8-27B，vLLM OpenAI 兼容 API）
LLM_BASE_URL=http://<LLM服务器IP>:8000/v1
LLM_MODEL=qwen3.8-27b-awq
LLM_API_KEY=EMPTY

# RAGFlow（应用服务器）
RAGFLOW_BASE_URL=http://<应用服务器IP>
RAGFLOW_API_KEY=在此粘贴RAGFlow系统设置里生成的API-KEY

# 默认检索知识库（历史标书库/资质业绩库/项目案例库的 dataset_id，逗号分隔）
KB_DATASET_IDS=
RETRIEVAL_TOP_K=8
RETRIEVAL_SIM_THRESHOLD=0.2

# 定稿归档回流的知识库（历史标书库）
BID_ARCHIVE_DATASET_ID=

# 调优（可保持默认）
COMPLIANCE_LLM_CHECK_MAX=20
CHUNK_SIZE=6000
