{
  "template_id": "hebei-baoding-v2",
  "name": "保定市技术暗标口径",
  "region": "河北省",
  "scope": {
    "city": ["保定市"],
    "industry": ["工程", "房建", "市政"],
    "tender_type": ["工程"],
    "note": "地市细则优先于省级通用规定（特别优于一般）"
  },
  "legal_level": "NORMATIVE",
  "effective_from": "2024-01-01",
  "effective_to": "",
  "status": "ACTIVE",
  "supersedes": ["hebei-baoding-v1"],
  "basis": "保定市在省级\"双盲\"评审框架下发布的技术暗标编制细化要求（地市细则）",
  "source_url": "https://www.baoding.gov.cn/",
  "rules": [
    {
      "id": "FONT.FAMILY.BODY",
      "name": "正文字体必须为宋体",
      "category": "FORMAT",
      "type": "HARD",
      "severity": "REJECT",
      "detect": "run.font.name",
      "expect": { "eastAsia": ["宋体", "SimSun"] },
      "message": "技术暗标正文字体必须为宋体",
      "suggestion": "全选正文，中文字体统一设为宋体",
      "basis": "保定市技术暗标细化要求",
      "auto_fixable": true
    },
    {
      "id": "FONT.SIZE.BODY",
      "name": "正文字号为小四（12pt）",
      "category": "FORMAT",
      "type": "HARD",
      "severity": "REJECT",
      "detect": "run.font.size",
      "expect": { "pt": 12.0, "tolerance": 0.01, "exclude_styles": ["标题", "Heading", "表头"] },
      "message": "保定口径正文字号必须为小四（12 磅），与省级四号口径不同",
      "suggestion": "正文字号统一设为小四（12 磅）",
      "basis": "保定市技术暗标细化要求",
      "auto_fixable": true
    },
    {
      "id": "PARA.LINE_SPACING",
      "name": "行距为 1.5 倍行距",
      "category": "FORMAT",
      "type": "HARD",
      "severity": "REJECT",
      "detect": "paragraph.line_spacing",
      "expect": { "multiple": 1.5, "rule": "auto", "tolerance": 0.02 },
      "message": "保定口径行距必须为 1.5 倍行距，与省级固定值 30 磅口径不同",
      "suggestion": "段落→行距→1.5 倍行距；不要使用固定值",
      "basis": "保定市技术暗标细化要求",
      "auto_fixable": true
    },
    {
      "id": "PAGE.MARGIN",
      "name": "页边距四边均为 2.5cm",
      "category": "FORMAT",
      "type": "HARD",
      "severity": "REJECT",
      "detect": "doc.page.margins",
      "expect": { "top_cm": 2.5, "bottom_cm": 2.5, "left_cm": 2.5, "right_cm": 2.5, "tolerance_cm": 0.05 },
      "message": "保定口径页边距应为四边均 2.5cm",
      "suggestion": "页面布局→页边距→自定义，四边均设为 2.5 厘米",
      "basis": "保定市技术暗标细化要求",
      "auto_fixable": true
    },
    {
      "id": "FONT.COLOR",
      "name": "不得使用彩色文字",
      "category": "FORMAT",
      "type": "HARD",
      "severity": "REJECT",
      "detect": "run.color",
      "expect": { "allowed": ["000000", "auto", ""] },
      "message": "技术暗标不得出现彩色文字",
      "suggestion": "全文文字颜色改为黑色",
      "basis": "保定市技术暗标细化要求",
      "auto_fixable": true
    },
    {
      "id": "DOC.NO_HEADER_FOOTER",
      "name": "不得设置页眉页脚（含页码）",
      "category": "DISCLOSURE",
      "type": "HARD",
      "severity": "REJECT",
      "detect": "doc.marks.headers_footers",
      "expect": { "max": 0 },
      "message": "技术暗标不得设置页眉、页脚和页码",
      "suggestion": "删除全部页眉页脚",
      "basis": "保定市技术暗标细化要求",
      "auto_fixable": true
    },
    {
      "id": "DOC.NO_WATERMARK",
      "name": "不得出现水印、徽标、LOGO",
      "category": "DISCLOSURE",
      "type": "HARD",
      "severity": "REJECT",
      "detect": "doc.marks.watermark",
      "expect": { "max": 0 },
      "message": "检测到水印或图片型徽标",
      "suggestion": "删除水印与公司 LOGO",
      "basis": "保定市技术暗标细化要求",
      "auto_fixable": true
    },
    {
      "id": "DOC.PAGE_COUNT",
      "name": "篇幅按招标文件约定（缺省 ≤100 页）",
      "category": "STRUCTURE",
      "type": "SOFT",
      "severity": "WARN",
      "detect": "doc.page_count",
      "expect": { "max": 100 },
      "message": "篇幅超过 100 页，请核对招标文件是否另有字数/页数上限",
      "suggestion": "以招标文件载明的页数或字数上限为准，超出部分精简",
      "basis": "保定市技术暗标细化要求（以招标文件为准）",
      "auto_fixable": false
    },
    {
      "id": "PARA.FIRST_LINE_INDENT",
      "name": "正文首行缩进 2 字符",
      "category": "FORMAT",
      "type": "SOFT",
      "severity": "WARN",
      "detect": "paragraph.first_line_indent",
      "expect": { "chars": 2.0, "tolerance": 0.3, "exclude_styles": ["标题", "Heading"] },
      "message": "正文段落建议首行缩进 2 字符",
      "suggestion": "段落→特殊格式→首行缩进 2 字符",
      "basis": "保定市技术暗标细化要求（排版通行要求）",
      "auto_fixable": true
    }
  ]
}
