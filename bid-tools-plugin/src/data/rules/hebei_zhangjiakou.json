{
  "template_id": "hebei-zhangjiakou-v2",
  "name": "张家口等市技术暗标口径（宋体四号 + 1.5 倍行距）",
  "region": "河北省",
  "scope": {
    "city": ["张家口市", "承德市", "秦皇岛市", "廊坊市"],
    "industry": ["工程", "房建", "市政"],
    "tender_type": ["工程"],
    "note": "省级字体口径 + 1.5 倍行距，页边距沿用省级上 2.5 / 下 2 / 左右 2"
  },
  "legal_level": "NORMATIVE",
  "effective_from": "2024-01-01",
  "effective_to": "",
  "status": "ACTIVE",
  "supersedes": ["hebei-zhangjiakou-v1"],
  "basis": "张家口等市在省级\"双盲\"评审框架下发布的技术暗标编制细化要求",
  "source_url": "https://www.zjk.gov.cn/",
  "rules": [
    {
      "id": "FONT.FAMILY.BODY",
      "name": "正文字体必须为宋体",
      "category": "FORMAT",
      "type": "HARD",
      "severity": "REJECT",
      "detect": "run.font.name",
      "expect": { "eastAsia": ["宋体", "SimSun"] },
      "message": "技术暗标正文字体必须为宋体",
      "suggestion": "全选正文，中文字体统一设为宋体",
      "basis": "张家口市技术暗标细化要求",
      "auto_fixable": true
    },
    {
      "id": "FONT.SIZE.BODY",
      "name": "正文字号为四号（14pt）",
      "category": "FORMAT",
      "type": "HARD",
      "severity": "REJECT",
      "detect": "run.font.size",
      "expect": { "pt": 14.0, "tolerance": 0.01, "exclude_styles": ["标题", "Heading", "表头"] },
      "message": "正文字号必须为四号（14 磅）",
      "suggestion": "正文字号统一设为四号（14 磅）",
      "basis": "张家口市技术暗标细化要求",
      "auto_fixable": true
    },
    {
      "id": "PARA.LINE_SPACING",
      "name": "行距为 1.5 倍行距",
      "category": "FORMAT",
      "type": "HARD",
      "severity": "REJECT",
      "detect": "paragraph.line_spacing",
      "expect": { "multiple": 1.5, "rule": "auto", "tolerance": 0.02 },
      "message": "行距必须为 1.5 倍行距（本口径不采用省级固定值 30 磅）",
      "suggestion": "段落→行距→1.5 倍行距",
      "basis": "张家口市技术暗标细化要求",
      "auto_fixable": true
    },
    {
      "id": "PAGE.MARGIN",
      "name": "页边距上 2.5cm、下 2cm、左 2cm、右 2cm",
      "category": "FORMAT",
      "type": "HARD",
      "severity": "REJECT",
      "detect": "doc.page.margins",
      "expect": { "top_cm": 2.5, "bottom_cm": 2.0, "left_cm": 2.0, "right_cm": 2.0, "tolerance_cm": 0.05 },
      "message": "页边距应为上 2.5cm / 下 2cm / 左 2cm / 右 2cm",
      "suggestion": "页面布局→页边距→按上 2.5、下 2、左 2、右 2 厘米设置",
      "basis": "张家口市技术暗标细化要求",
      "auto_fixable": true
    },
    {
      "id": "FONT.COLOR",
      "name": "不得使用彩色文字",
      "category": "FORMAT",
      "type": "HARD",
      "severity": "REJECT",
      "detect": "run.color",
      "expect": { "allowed": ["000000", "auto", ""] },
      "message": "技术暗标不得出现彩色文字",
      "suggestion": "全文文字颜色改为黑色",
      "basis": "张家口市技术暗标细化要求",
      "auto_fixable": true
    },
    {
      "id": "DOC.NO_HEADER_FOOTER",
      "name": "不得设置页眉页脚（含页码）",
      "category": "DISCLOSURE",
      "type": "HARD",
      "severity": "REJECT",
      "detect": "doc.marks.headers_footers",
      "expect": { "max": 0 },
      "message": "技术暗标不得设置页眉、页脚和页码",
      "suggestion": "删除全部页眉页脚",
      "basis": "张家口市技术暗标细化要求",
      "auto_fixable": true
    },
    {
      "id": "DOC.NO_WATERMARK",
      "name": "不得出现水印、徽标、LOGO",
      "category": "DISCLOSURE",
      "type": "HARD",
      "severity": "REJECT",
      "detect": "doc.marks.watermark",
      "expect": { "max": 0 },
      "message": "检测到水印或图片型徽标",
      "suggestion": "删除水印与公司 LOGO",
      "basis": "张家口市技术暗标细化要求",
      "auto_fixable": true
    },
    {
      "id": "PARA.FIRST_LINE_INDENT",
      "name": "正文首行缩进 2 字符",
      "category": "FORMAT",
      "type": "SOFT",
      "severity": "WARN",
      "detect": "paragraph.first_line_indent",
      "expect": { "chars": 2.0, "tolerance": 0.3, "exclude_styles": ["标题", "Heading"] },
      "message": "正文段落建议首行缩进 2 字符",
      "suggestion": "段落→特殊格式→首行缩进 2 字符",
      "basis": "张家口市技术暗标细化要求（排版通行要求）",
      "auto_fixable": true
    }
  ]
}
